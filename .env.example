# Porta da API local
PORT=3001

# Endpoint público da Deriv (dados de mercado e cotações, sem login)
DERIV_PUBLIC_WS=wss://api.derivws.com/trading/v1/options/ws/public

# --- Fase futura (execução em DEMO) ---
